# Shared password for the site (set in Vercel project settings for production).
FAMILY_PASSWORD=
# Random string used to sign the login cookie: `openssl rand -hex 32`.
AUTH_SECRET=
# Read-write token of the private Vercel Blob store. Leave unset locally to read
# straight from ../family_facial_recognition/data/web_export instead.
BLOB_READ_WRITE_TOKEN=
# Replicate API token for the "AI fix" tools (restore, fix faces, colorize, upscale).
REPLICATE_API_TOKEN=
